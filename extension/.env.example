# The extension's Supabase project. Copy to extension/.env (git-ignored) and rebuild.
#
# Both values are public: the publishable key only reaches what row-level security allows a
# signed-in user. Never put a secret key or a model API key here; those belong in
# supabase/functions/.env (see the root .env.example).
#
# Local: `pnpm exec supabase status` prints the API URL and the publishable key.
# Hosted: Project Settings > API Keys.
# Leave both empty to build without backup and sync.
WXT_SUPABASE_URL=
WXT_SUPABASE_PUBLISHABLE_KEY=
