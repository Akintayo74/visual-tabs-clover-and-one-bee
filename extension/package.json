{
  "name": "extension",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "e2e": "wxt build --mode e2e && playwright test --grep-invert @sync",
    "test:server": "vitest run --config vitest.server.config.ts",
    "e2e:sync": "wxt build --mode e2e && playwright test --grep @sync",
    "package": "tsx scripts/check-package-env.ts && wxt zip"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "fflate": "0.8.3",
    "idb": "^8.0.4"
  }
}
