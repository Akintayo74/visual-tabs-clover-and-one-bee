# Secrets for Supabase Edge Functions. Never put these in the extension.
#
# Local: copy to supabase/functions/.env (git-ignored); `supabase functions serve` reads it.
# Hosted: `supabase secrets set --env-file supabase/functions/.env`.
#
# process-save uses both; search uses the Voyage key (without it, search falls back to keywords).
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Only for the eval and the reprocess job, run from your own machine (never deployed, never in
# the extension). The secret key is in Project Settings > API Keys.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# EVAL_USER_EMAIL=
